<Window x:Class="FolderSpace.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FolderSpace" Width="440" Height="520" MinWidth="390" MinHeight="430" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#34363B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#303238"/><Setter Property="BorderBrush" Value="#52545A"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="17"/></Style>
 </Window.Resources>
 <Border CornerRadius="19" Background="#E6222429" BorderBrush="#666A7078" BorderThickness="1" Padding="18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="MENÜ ADI" FontSize="10" Foreground="#A7AAB2" Margin="3,0,0,4"/>
     <TextBox x:Name="TitleBox" LostFocus="SaveTitle" KeyDown="TitleKeyDown" FontWeight="SemiBold"/>
    </StackPanel>
    <Button Grid.Column="1" Content="✕" Click="CloseClick" VerticalAlignment="Top"/>
   </Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
    <Button Content="☰ Menüler" Click="ShowMenus"/>
    <Button Content="＋ Yeni menü" Click="NewMenu"/>
    <Button Content="⌂ Masaüstüne ekle" Click="DesktopShortcut"/>
    <Button Content="◈ Simge Seç" Click="ChooseIcon"/>
   </StackPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SlowScroll" CanContentScroll="False">
    <ItemsControl x:Name="AppsList">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Margin="5" Background="#603A3D44" CornerRadius="12" Padding="4">
        <Grid>
         <Button Tag="{Binding}" Click="LaunchApp" Height="94" Background="Transparent" Padding="4">
          <StackPanel VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,0,7"/><TextBlock Text="{Binding Name}" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" MaxWidth="110"/></StackPanel>
         </Button>
         <Button Content="×" Tag="{Binding}" Click="RemoveApp" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,0" FontSize="12" Background="#AA55565D"/>
        </Grid>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <Button Grid.Row="3" Content="＋ Uygulama Ekle" Click="AddApps" Background="#5B5D65" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" Height="46"/>
  </Grid>
 </Border>
</Window>
